# Copy to .env and adjust as needed. .env itself is gitignored.
# This file lists variable NAMES only; never put real values in it.

# --- Local development (read by docker-compose.yml) ---
POSTGRES_DB=fantulia_dev
POSTGRES_USER=fantulia
POSTGRES_PASSWORD=change-me-locally

# --- Production: API on the VM, file /etc/fantulia/env (mode 600), not in this repo ---
# SPRING_PROFILES_ACTIVE=prod
# SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-direct-host>/<database>?sslmode=require
# SPRING_DATASOURCE_USERNAME=<neon-user>
# SPRING_DATASOURCE_PASSWORD=<neon-password>

# --- Production: Caddy on the VM, set in Caddy's service environment ---
# ORIGIN_SECRET=<long random string, same value as below>

# --- Production: Cloudflare Pages project settings (encrypted variables) ---
# API_ORIGIN=https://origin.fantulia.com
# ORIGIN_SECRET=<same value as above>

# --- Production: GitHub Actions repository secrets ---
# SSH_PRIVATE_KEY, VM_HOST, VM_USER, ORIGIN_SECRET
